# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/

# Build logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Claude Code config — fully local. The harness auto-writes permission
# additions to settings.json every time a new path is approved, which
# clutters GitHub Desktop each session. Matches readers-gnt (commit 4af66ce)
# and readers-bofm gitignore policy.
.claude/settings.json
.claude/settings.local.json

# Overseer workspace — session notes, OVERSEER-DIRECTIONS, sync logs, etc. (matches sibling repos)
# Private material stays local. The README stub is the exception and IS
# tracked, so the folder's purpose and layout survive even though its
# contents cannot. A bare `private/` cannot be negated into -- git will not
# descend into an ignored directory -- so the contents are ignored instead.
/private/*
!/private/README.md

# Scratch — throwaway dev artifacts (probes, test HTML, one-off xlsx). Keep on
# disk, out of git. Promote reusable scripts to src/ or research/.
scratch/
